{
  "title": "Update catalog history parameters",
  "componentCategory": "processor",
  "componentType": "update_catalog_history",
  "difwStepCategory": "process",
  "difwStepType": "update_catalog_history",
  "displayName": "Update catalog history",
  "documentationLink": "https://github.com/merck-gen/mf-difw-core/blob/{branch}/documentation/configuration/steps/spark/processors/update_catalog_history.md",
  "flowValidations": "#extendByFile:common/process_flow_validations_processors.json",
  "platforms": {
    "glue": {
      "supportedJobTypes": [
        "spark"
      ]
    },
    "databricks": {
      "supportedJobTypes": [
        "spark_databricks"
      ]
    }
  },
  "attributes": [
    {
      "attributeName": "curated_database",
      "displayName": "Curated database name",
      "description": "Name of the database in glue which corresponds with the curated database",
      "type": {
        "objectType": "string"
      },
      "required": true,
      "isBasicAttribute": true,
      "isOverwriteable": true,
      "value": "{{glue_databases.c_db.database_name}}"
    },
    {
      "attributeName": "history_database",
      "displayName": "History database name",
      "description": "Name of the database in glue which corresponds with the history database",
      "type": {
        "objectType": "string"
      },
      "required": true,
      "isBasicAttribute": true,
      "isOverwriteable": true,
      "value": ""
    },
    {
      "attributeName": "writer_config",
      "displayName": "Writer config",
      "description": "Configuration of internal parquet writer used by this  processor (settings related to output file location are ignored)",
      "type": {
        "objectType": "dictionary"
      },
      "required": false,
      "isOverwriteable": true,
      "value": {},
      "isBasicAttribute": false
    },
    {
      "attributeName": "custom_table_properties",
      "displayName": "Custom table properties",
      "description": "User-defined key-value pairs to be set in TBLPROPERTIES. If the value is null, the property is unset",
      "type": {
        "objectType": "dictionary"
      },
      "required": false,
      "isOverwriteable": true,
      "value": {},
      "isBasicAttribute": false
    },
    {
      "attributeName": "update_glue_description",
      "displayName": "Update glue description",
      "description": "Updates glue table description parameter in glue catalog. Available only for glue catalog",
      "type": {
        "objectType": "boolean"
      },
      "required": true,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": false
    },
    {
      "attributeName": "s3_bucket",
      "displayName": "S3 bucket",
      "description": "History table s3 bucket",
      "type": {
        "objectType": "string",
        "s3Browsing": {
          "subType": "bucket",
          "relatedS3BrowserAttrName": "s3_layer_path"
        }
      },
      "required": true,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": "{{data_bucket}}"
    },
    {
      "attributeName": "s3_layer_path",
      "displayName": "S3 layer path",
      "description": "History table s3 path",
      "type": {
        "objectType": "string",
        "s3Browsing": {
          "subType": "key",
          "relatedS3BrowserAttrName": "s3_bucket"
        }
      },
      "required": true,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": ""
    },
    {
      "attributeName": "enable_cache",
      "displayName": "Enable cache",
      "description": "Persists intermediate transformation to the default storage level MEMORY_AND_DISK. If a table has many columns, the execution plan generated by spark can be too big and can causes a job failure due to the stackOverflow issue. Enabling cache option avoid a job failure as the intermediate data are persisted",
      "type": {
        "objectType": "boolean"
      },
      "required": true,
      "isOverwriteable": true,
      "isBasicAttribute": false,
      "value": false
    },
    {
      "attributeName": "customization",
      "displayName": "Customization",
      "description": "Custom modification of historization process",
      "type": {
        "objectType": "object",
        "attributes": "#extendByFile:../common/common_history_customization.json"
      },
      "required": false,
      "value": {},
      "isBasicAttribute": false
    }
  ]
}