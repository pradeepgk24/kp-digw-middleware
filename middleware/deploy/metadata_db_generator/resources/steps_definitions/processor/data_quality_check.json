{
  "title": "Data quality check parameters",
  "componentCategory": "processor",
  "componentType": "data_quality_check",
  "difwStepCategory": "process",
  "difwStepType": "data_quality_check",
  "displayName": "Data quality check",
  "documentationLink": "https://github.com/merck-gen/mf-difw-core/blob/{branch}/documentation/configuration/steps/spark/processors/data_quality_check.md",
  "flowValidations": "#extendByFile:common/process_flow_validations_processors.json",
  "platforms": {
    "glue": {
      "supportedJobTypes": [
        "spark"
      ]
    },
    "databricks": {
      "supportedJobTypes": [
        "spark_databricks"
      ]
    }
  },
  "attributes": [
    {
      "attributeName": "invalid_row_count_dq_rule",
      "displayName": "Invalid row count DQ rule",
      "description": "DQ rule for invalid row count",
      "type": {
        "objectType": "object",
        "attributes": [
          {
            "attributeName": "invalid_row_count_filter",
            "displayName": "Invalid row count filter",
            "description": "Spark filter condition to find invalid rows",
            "type": {
              "objectType": "string"
            },
            "required": true,
            "isOverwriteable": true,
            "value": ""
          },
          {
            "attributeName": "invalid_row_count_threshold",
            "displayName": "Invalid row count threshold",
            "description": "Minimum number of invalid rows needed to fail the ingest",
            "type": {
              "objectType": "number",
              "scale": 0,
              "precision": 7
            },
            "isOverwriteable": true,
            "value": null,
            "required": false
          },
          {
            "attributeName": "invalid_row_percentage_threshold",
            "displayName": "Invalid row percentage threshold",
            "description": "(0 to 100) Minimum percentage of invalid rows needed to fail the ingest",
            "type": {
              "objectType": "number",
              "scale": 0,
              "precision": 3
            },
            "isOverwriteable": true,
            "value": null,
            "required": false
          },
          {
            "attributeName": "action",
            "displayName": "Action",
            "description": "fail = throw an exception, log = only write to log",
            "type": {
              "objectType": "options",
              "values": [
                {
                  "value": "fail",
                  "displayValue": "Fail"
                },
                {
                  "value": "log",
                  "displayValue": "Log"
                }
              ]
            },
            "isOverwriteable": true,
            "required": true,
            "value": "fail"
          }
        ]
      },
      "required": false,
      "isOverwriteable": true,
      "isBasicAttribute": true
    },
    {
      "attributeName": "invalid_data_type_dq_rule",
      "displayName": "Invalid data type DQ rule",
      "description": "DQ rule for invalid data type",
      "type": {
        "objectType": "object",
        "attributes": [
          {
            "attributeName": "action",
            "displayName": "Action",
            "description": "Action which will be perform if data type is incorrect",
            "type": {
              "objectType": "object",
              "attributes": [
                {
                  "attributeName": "fail",
                  "displayName": "Fail",
                  "description": "Throw exception if invalid data type will be found",
                  "type": {
                    "objectType": "boolean"
                  },
                  "required": true,
                  "value": false,
                  "isOverwriteable": true
                },
                {
                  "attributeName": "log",
                  "displayName": "Log",
                  "description": "Log error if invalid data type will be found",
                  "type": {
                    "objectType": "boolean"
                  },
                  "required": true,
                  "value": true,
                  "isOverwriteable": true
                },
                {
                  "attributeName": "remove_last_partition",
                  "displayName": "Remove last partition",
                  "description": "Remove data if invalid data type will be founds",
                  "type": {
                    "objectType": "boolean"
                  },
                  "required": true,
                  "value": false,
                  "isOverwriteable": true
                }
              ]
            },
            "required": false,
            "isBasicAttribute": false,
            "isOverwriteable": true
          }
        ]
      },
      "required": false,
      "isBasicAttribute": true,
      "isOverwriteable": true
    },
    {
      "attributeName": "s3_bucket",
      "displayName": "S3 bucket",
      "description": "Table s3 bucket",
      "type": {
        "objectType": "string",
        "s3Browsing": {
          "subType": "bucket",
          "relatedS3BrowserAttrName": "s3_layer_path"
        }
      },
      "required": true,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": "{{data_bucket}}"
    },
    {
      "attributeName": "s3_layer_path",
      "displayName": "S3 path",
      "description": "Table s3 path",
      "type": {
        "objectType": "string",
        "s3Browsing": {
          "subType": "key",
          "relatedS3BrowserAttrName": "s3_bucket"
        }
      },
      "required": true,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": "{{s3_paths.c_path}}"
    },
    {
      "attributeName": "static_file_location",
      "displayName": "Static file location",
      "description": "Use false, if a table is supposed to be partitioned using static_partitions parameter",
      "type": {
        "objectType": "boolean"
      },
      "required": true,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": false
    }
  ]
}
