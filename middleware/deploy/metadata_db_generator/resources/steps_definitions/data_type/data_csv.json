{
  "title": "Source data type CSV parameters",
  "componentCategory": "data_type",
  "componentType": "csv",
  "documentationLink": "https://github.com/merck-gen/mf-difw-core/blob/{branch}/documentation/configuration/steps/spark/loaders/csv.md",
  "difwStepCategory": "input",
  "difwStepType": "csv",
  "displayName": "CSV",
  "componentProperties": {
    "conditionType": "spark_sql"
  },
  "platforms": {
    "glue": {
      "supportedJobTypes": [
        "spark"
      ]
    },
    "databricks": {
      "supportedJobTypes": [
        "python_databricks"
      ]
    }
  },
  "flowValidations": "#extendByFile:common/process_flow_validations_data_type.json",
  "attributes": [
    {
      "attributeName": "spark_read_csv_options",
      "displayName": "Spark read csv options",
      "description": "Options of Spark CSV reader in key-value format. For complete list of Spark CSV reader options see  https://spark.apache.org/docs/3.1.1/api/python//reference/api/pyspark.sql.DataFrameReader.csv.html",
      "type": {
        "objectType": "dictionary"
      },
      "required": true,
      "isBasicAttribute": true,
      "isOverwriteable": true,
      "value": {
        "header": true,
        "quote": "\"",
        "inferSchema": true,
        "sep": ",",
        "encoding": "utf-8"
      }
    },
    {
      "attributeName": "custom_spark_csv_loader_options",
      "displayName": "Custom spark read csv options",
      "description": "Custom options of Spark CSV reader",
      "required": false,
      "type": {
        "objectType": "object",
        "attributes": [
          {
            "attributeName": "add_meta_input_file_name_column",
            "displayName": "Add meta column 'file_name'",
            "description": "Flag indicates if meta input file name columns will be added or not",
            "type": {
              "objectType": "boolean"
            },
            "required": true,
            "isOverwriteable": true,
            "value": false
          },
          {
            "attributeName": "file_regex",
            "displayName": "Source file regex",
            "description": "Regular expression to filter out files that are loaded",
            "type": {
              "objectType": "string"
            },
            "required": true,
            "isOverwriteable": true,
            "value": ".*"
          },
          "#extendByFile:common/source_data_types_bad_lines_detection_attributes.json"
        ],
        "isOverwriteable": true,
        "isBasicAttribute": true
      }
    },
    "#extendByFile:common/source_data_types_common_attributes.json",
    "#extendByFile:common/source_data_types_repartition_attributes.json",
    "#extendByFile:common/common_blob_storage_connection_data_types.json"
  ]
}