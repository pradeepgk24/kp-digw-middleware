{
  "title": "Source HDFS parameters",
  "componentCategory": "input_connector",
  "componentType": "hdfs",
  "documentationLink": "https://github.com/merck-gen/mf-difw-core/blob/{branch}/documentation/configuration/steps/common/processors/acq_from_webhdfs.md",
  "difwStepCategory": "process",
  "difwStepType": "acq_from_webhdfs",
  "displayName": "HDFS",
  "flowValidations": "#extendByFile:common/process_flow_validations_file_based_in_connectors.json",
  "platforms": {
    "glue": {
      "supportedJobTypes": [
        "python",
        "spark"
      ]
    },
    "databricks": {
      "supportedJobTypes": [
        "python_databricks",
        "spark_databricks"
      ]
    }
  },
  "componentProperties": {
    "supportExternalAwsStorage": true
  },
  "attributes": [
    {
      "attributeName": "url_prefix",
      "displayName": "URL prefix",
      "description": "e.g. https://knoxba-01.bdptest.gin.merck.com:8443/gateway/default/webhdfs/v1",
      "type": {
        "objectType": "string"
      },
      "required": true,
      "isOverwriteable": false,
      "isBasicAttribute": true,
      "value": ""
    },
    {
      "attributeName": "username",
      "displayName": "Username",
      "description": "Username",
      "type": {
        "objectType": "string"
      },
      "required": true,
      "isOverwriteable": false,
      "isBasicAttribute": true,
      "value": ""
    },
    {
      "attributeName": "password",
      "displayName": "Password",
      "description": "Password",
      "required": true,
      "type": {
        "objectType": "secret"
      },
      "isOverwriteable": false,
      "isBasicAttribute": true,
      "value": {}
    },
    {
      "attributeName": "get_most_recent_file",
      "displayName": "Get most recent file",
      "description": "If more files match file_regex, the most recent one is downloaded",
      "type": {
        "objectType": "boolean"
      },
      "required": false,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": false
    },
    {
      "attributeName": "hdfs_dir_path",
      "displayName": "HDFS directory path",
      "description": "HDFS dir path (e.g. /data/mmd/dev/apo/global/landing/MOS_ACTIVITIES). Common prefix of hdfs path may be added to url_prefix to avoid its repetition",
      "type": {
        "objectType": "string"
      },
      "required": false,
      "isOverwriteable": true,
      "value": "",
      "isBasicAttribute": false
    },
    {
      "attributeName": "file_regex",
      "displayName": "File regex",
      "description": "Regular expression to match files in hdfs_dir_path",
      "type": {
        "objectType": "string"
      },
      "required": false,
      "isBasicAttribute": false,
      "isOverwriteable": true,
      "value": ".*"
    },
    "#extendByFile:common/source_connection_common_attributes.json"
  ]
}