{
  "permissionName": "viewer",
  "effect": "allow",
  "description": "Right to view whatever settings or created resources",
  "permissionActions": [
    {
      "actionType": "readPipeline",
      "actionDetail": {
        "pipelineName": ".*"
      }
    },
    {
      "actionType": "readPipelineTemplate",
      "actionDetail": {
        "pipelineTemplateName": ".*"
      }
    },
    {
      "actionType": "readComponentTemplate",
      "actionDetail": {
        "componentTemplateName": ".*"
      }
    },
    {
      "actionType": "readPermission",
      "actionDetail": {}
    },
    {
      "actionType": "accessIam",
      "actionDetail": {}
    },
    {
      "actionType": "accessProjectSettings",
      "actionDetail": {}
    },
    {
      "actionType": "readSecret",
      "actionDetail": {
        "secretName": ".*"
      }
    },
    {
      "actionType": "readSubject",
      "actionDetail": {
        "subjectType": ".*",
        "subjectId": ".*"
      }
    },
    {
      "actionType": "readProjectSettings",
      "actionDetail": {
        "settingsType": ".*"
      }
    },
    {
      "actionType": "readWorkflow",
      "actionDetail": {
